---
// Home page — hero section built to match the Figma design
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>vibe. — Design &amp; Development Studio</title>
		<meta name="description" content="We're a design and development studio for businesses." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a href="/" class="logo">vibe.</a>

			<nav class="nav-links">
				<a href="#services">Services</a>
				<a href="#products">Products</a>
				<a href="#about">About</a>
			</nav>

			<a href="/proposal" class="cta">
				Get Started
				<span class="cta-arrow" aria-hidden="true">↗</span>
			</a>
		</header>

		<main>
			<section class="hero">
				<h1>We're a design and development studio for businesses.</h1>
			</section>

			<section class="showcase" aria-hidden="true"></section>

			<section id="services" class="services">
				<h2 class="section-title">Services<span class="dot">.</span></h2>

				<div class="services-grid">
					<div class="services-list">
						<button class="service-item is-active" type="button">AI</button>
						<button class="service-item" type="button">Website</button>
						<button class="service-item" type="button">Mobile App</button>
						<button class="service-item" type="button">Logo &amp; branding</button>
						<button class="service-item" type="button">3rd party Integration</button>
					</div>

					<div class="services-preview" aria-hidden="true"></div>
				</div>
			</section>

			<section id="products" class="products">
				<h2 class="section-title">Products<span class="dot">.</span></h2>

				<div class="products-list">
					<div class="product-item">Req-Analyzer</div>
					<div class="product-item">BirdsGen</div>
					<div class="product-item">SignRoute</div>
					<div class="product-item">CityReport-AI</div>
					<div class="product-item">Humidity control system - IOT</div>
				</div>
			</section>
			<section id="about" class="about">
				<div class="about-grid">
					<div class="about-content">
						<h2 class="about-title">Who we Are?</h2>
						<p class="about-text">
							We started Vibe Solutions with one idea: small businesses deserve the same
							quality of design and technology that big companies pay a fortune for. So we
							built a team that does it all — design, development, deployment — without the
							agency price tag.
						</p>
					</div>

					<div class="about-visual" aria-hidden="true"></div>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-inner">
				<p class="footer-email">vibesolutions.official@gmail.com</p>
				<h2 class="footer-heading">Got an idea? <span class="underline">Let's build it.</span></h2>
				<a href="/proposal" class="footer-cta">Start Proposal</a>
			</div>

			<div class="footer-bottom">
				<span class="footer-logo">vibe.</span>
				<div class="footer-socials" aria-hidden="true">
					<span class="social-circle"></span>
					<span class="social-circle"></span>
					<span class="social-circle"></span>
					<span class="social-circle"></span>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
		color: #111111;
		background: #ffffff;
		-webkit-font-smoothing: antialiased;
	}

	/* ---------- Header / Nav ---------- */
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 28px 48px;
		max-width: 1100px;
		margin: 0 auto;
	}

	.logo {
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: -0.01em;
		color: #111111;
		text-decoration: none;
	}

	.nav-links {
		display: flex;
		gap: 36px;
	}

	.nav-links a {
		color: #333333;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		transition: color 0.15s ease;
	}

	.nav-links a:hover {
		color: #111111;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: #111111;
		color: #ffffff;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
		padding: 11px 20px;
		border-radius: 999px;
		transition: background 0.15s ease;
	}

	.cta:hover {
		background: #2a2a2a;
	}

	.cta-arrow {
		font-size: 0.9rem;
		line-height: 1;
	}

	/* ---------- Hero ---------- */
	.hero {
		max-width: 1100px;
		margin: 0 auto;
		padding: 64px 48px 110px;
	}

	.hero h1 {
		font-family: 'Lora', Georgia, 'Times New Roman', Times, serif;
		font-weight: 500;
		font-size: 3.1rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
		max-width: 660px;
		padding-left: 22px;
		border-left: 2px solid #111111;
	}

	/* ---------- Showcase (dark block) ---------- */
	.showcase {
		background: #1c1c1c;
		width: 100%;
		height: 60vh;
		min-height: 420px;
	}

	/* ---------- Services ---------- */
	.services {
		max-width: 1100px;
		margin: 0 auto;
		padding: 90px 48px 130px;
		scroll-margin-top: 32px;
	}

	.section-title {
		font-family: 'Lora', Georgia, 'Times New Roman', Times, serif;
		font-weight: 700;
		font-size: 2.6rem;
		letter-spacing: -0.01em;
		position: relative;
		display: inline-block;
	}

	.section-title .dot {
		color: #111111;
	}

	.services-grid {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 24px;
		margin-top: 56px;
	}

	.services-list {
		display: flex;
		flex-direction: column;
		background: #1c1c1c;
		border-radius: 20px;
		overflow: hidden;
	}

	.service-item {
		appearance: none;
		border: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		background: transparent;
		color: rgba(255, 255, 255, 0.55);
		font-family: inherit;
		font-size: 0.95rem;
		font-weight: 500;
		text-align: left;
		padding: 24px 22px;
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.service-item:last-child {
		border-bottom: none;
	}

	.service-item:hover {
		color: #ffffff;
	}

	.service-item.is-active {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.06);
	}

	.services-preview {
		background: #1c1c1c;
		border-radius: 20px;
		min-height: 360px;
	}

	/* ---------- Products ---------- */
	.products {
		max-width: 1100px;
		margin: 0 auto;
		padding: 90px 48px 130px;
		scroll-margin-top: 32px;
		text-align: center;
	}

	.products .section-title {
		display: block;
	}

	.products-list {
		margin-top: 56px;
		margin-left: calc(50% - 50vw);
		margin-right: calc(50% - 50vw);
		border-top: 1px solid rgba(17, 17, 17, 0.3);
		text-align: left;
	}

	.product-item {
		padding: 24px calc((100vw - 1100px) / 2 + 48px);
		border-bottom: 1px solid rgba(17, 17, 17, 0.3);
		font-size: 1.15rem;
		color: #333333;
		transition: color 0.15s ease;
	}

	.product-item:hover {
		color: #111111;
	}

	@media (max-width: 720px) {
		.services-grid {
			grid-template-columns: 1fr;
		}

		.services-preview {
			min-height: 240px;
		}
	}

	@media (max-width: 640px) {
		.nav {
			padding: 20px 24px;
			flex-wrap: wrap;
			gap: 16px;
		}

		.nav-links {
			order: 3;
			width: 100%;
			gap: 20px;
		}

		.hero {
			padding: 40px 24px 64px;
		}

		.hero h1 {
			font-size: 2rem;
		}

		.services {
			padding: 56px 24px 80px;
		}

		.products {
			padding: 56px 24px 80px;
		}

		.section-title {
			font-size: 2rem;
		}

		.services-grid {
			margin-top: 36px;
		}

		.products-list {
			margin-top: 36px;
		}

		.product-item {
			padding: 20px 24px;
			font-size: 1rem;
		}
	}

	/* ---------- About ---------- */
	.about {
		max-width: 1100px;
		margin: 0 auto;
		padding: 90px 48px 150px;
		scroll-margin-top: 32px;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1fr 380px;
		gap: 60px;
		align-items: center;
	}

	.about-title {
		font-family: 'Lora', Georgia, 'Times New Roman', Times, serif;
		font-weight: 700;
		font-size: 2.4rem;
		letter-spacing: -0.01em;
		margin-bottom: 24px;
	}

	.about-text {
		font-size: 1rem;
		line-height: 1.7;
		color: #333333;
		max-width: 420px;
	}

	.about-visual {
		background: #1c1c1c;
		border-radius: 24px;
		aspect-ratio: 4 / 4.5;
		width: 100%;
	}

	@media (max-width: 720px) {
		.about-grid {
			grid-template-columns: 1fr;
		}

		.about-visual {
			order: -1;
			aspect-ratio: 4 / 3;
		}
	}

	@media (max-width: 640px) {
		.about {
			padding: 56px 24px 90px;
		}

		.about-title {
			font-size: 1.8rem;
		}
	}

	/* ---------- Footer ---------- */
	.footer {
		background: #1c1c1c;
		color: #ffffff;
		border-radius: 28px 28px 0 0;
	}

	.footer-inner {
		max-width: 820px;
		margin: 0 auto;
		padding: 80px 24px 56px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.footer-email {
		font-size: 0.95rem;
		color: rgba(255, 255, 255, 0.7);
		margin-bottom: 28px;
	}

	.footer-heading {
		font-family: 'Lora', Georgia, 'Times New Roman', Times, serif;
		font-weight: 700;
		font-size: 2.6rem;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}

	.footer-heading .underline {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
	}

	.footer-cta {
		display: inline-block;
		border: none;
		background: #ffffff;
		color: #111111;
		text-decoration: none;
		font-family: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		padding: 14px 28px;
		border-radius: 10px;
		margin-top: 48px;
		cursor: pointer;
		transition: background 0.15s ease;
	}

	.footer-cta:hover {
		background: #e8e8e8;
	}

	.footer-bottom {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 28px 48px;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
	}

	.footer-logo {
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
	}

	.footer-socials {
		display: flex;
		gap: 12px;
	}

	.social-circle {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.85);
	}

	@media (max-width: 640px) {
		.footer-inner {
			padding: 56px 24px 40px;
		}

		.footer-heading {
			font-size: 1.9rem;
		}

		.footer-bottom {
			padding: 24px;
			flex-wrap: wrap;
			gap: 16px;
			justify-content: center;
		}
	}
</style>