---
// Proposal page — "Project Details" form
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Project Details — vibe.</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="topbar">
			<a href="/" class="back" aria-label="Go back">←</a>
			<span class="brand">vibe.</span>
			<span class="spacer" aria-hidden="true"></span>
		</header>

		<hr class="divider" />

		<main class="form-page">
			<h1 class="form-title">Project Details</h1>

			<form class="proposal-form">
				<div class="row row-3">
					<div class="field">
						<label for="fullname">Full name:</label>
						<input id="fullname" name="fullname" type="text" placeholder="John Doe" />
					</div>
					<div class="field">
						<label for="phone">Phone:</label>
						<input id="phone" name="phone" type="tel" placeholder="+xx-xxxxxxxxxx" />
					</div>
					<div class="field">
						<label for="email">Email:</label>
						<input id="email" name="email" type="email" placeholder="johndoe@gmail.com" />
					</div>
				</div>

				<div class="row row-postal-address">
					<div class="field">
						<label for="postal">Postal code:</label>
						<input id="postal" name="postal" type="text" placeholder="xxxxx" />
					</div>
					<div class="field">
						<label for="address">Address:</label>
						<input
							id="address"
							name="address"
							type="text"
							placeholder="123 Main Street Springfield, XY 12345 USA"
						/>
					</div>
				</div>

				<div class="row row-company">
					<div class="field">
						<label for="company">Company name:</label>
						<input id="company" name="company" type="text" placeholder="xyz" />
					</div>
				</div>

				<div class="row">
					<div class="field">
						<label for="description">Brief Project Descrtiption:</label>
						<textarea
							id="description"
							name="description"
							rows="5"
							placeholder="I want to build an xyz system to …"
						></textarea>
					</div>
				</div>

				<div class="form-actions">
					<button type="submit" class="submit-btn">Send project details</button>
				</div>
			</form>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	:global(body) {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
		color: #111111;
		background: #ffffff;
		-webkit-font-smoothing: antialiased;
	}

	/* ---------- Top bar ---------- */
	.topbar {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 24px 48px 20px;
	}

	.back {
		color: #111111;
		text-decoration: none;
		font-size: 1.2rem;
		line-height: 1;
	}

	.brand {
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: -0.01em;
	}

	.spacer {
		width: 1.2rem;
	}

	.divider {
		border: none;
		border-top: 1px solid rgba(17, 17, 17, 0.3);
		max-width: 1100px;
		margin: 0 auto;
	}

	/* ---------- Form ---------- */
	.form-page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 48px 48px 100px;
	}

	.form-title {
		font-family: 'Lora', Georgia, 'Times New Roman', Times, serif;
		font-weight: 700;
		font-size: 1.6rem;
		letter-spacing: -0.01em;
		margin-bottom: 40px;
	}

	.proposal-form {
		display: flex;
		flex-direction: column;
		gap: 28px;
		max-width: 760px;
	}

	.row {
		display: grid;
		gap: 24px;
	}

	.row-3 {
		grid-template-columns: repeat(3, 1fr);
	}

	.row-postal-address {
		grid-template-columns: 160px 1fr;
	}

	.row-company {
		grid-template-columns: 220px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.field label {
		font-size: 0.9rem;
		font-weight: 600;
		color: #111111;
	}

	.field input,
	.field textarea {
		font-family: inherit;
		font-size: 0.95rem;
		color: #111111;
		border: 1px solid rgba(17, 17, 17, 0.4);
		border-radius: 8px;
		padding: 12px 14px;
		background: #ffffff;
		outline: none;
		transition: border-color 0.15s ease;
	}

	.field input::placeholder,
	.field textarea::placeholder {
		color: #9a9a9a;
	}

	.field input:focus,
	.field textarea:focus {
		border-color: #111111;
	}

	.field textarea {
		resize: vertical;
		min-height: 130px;
	}

	.form-actions {
		display: flex;
		justify-content: flex-end;
	}

	.submit-btn {
		appearance: none;
		border: none;
		background: #111111;
		color: #ffffff;
		font-family: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		padding: 13px 22px;
		border-radius: 8px;
		cursor: pointer;
		transition: background 0.15s ease;
	}

	.submit-btn:hover {
		background: #2a2a2a;
	}

	@media (max-width: 720px) {
		.row-3 {
			grid-template-columns: 1fr;
		}

		.row-postal-address {
			grid-template-columns: 1fr;
		}

		.row-company {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.topbar {
			padding: 20px 24px 16px;
		}

		.form-page {
			padding: 32px 24px 64px;
		}
	}
</style>